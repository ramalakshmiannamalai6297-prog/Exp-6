pipeline {
 
    agent any
 
    stages {
 
        stage('Checkout') {
            steps {
                echo 'Checking out source code'
                checkout scm
            }
        }
 
        stage('Build') {
            steps {
                echo 'Building project'
                bat 'mvn -f Ramalakshmi/pom.xml'
            }
        }
 
        stage('Run Selenium Tests') {
            steps {
                echo 'Running Selenium Tests'
                bat 'mvn -f Ramalakshmi/pom.xml'
            }
        }
 
    }
 
}